+	if mldsaRejectedInOnlyMode {
+		expectErr(t, errRet2(mldsa.GenerateKey(mldsa.MLDSA44())))
+		expectErr(t, errRet2(mldsa.NewPrivateKey(mldsa.MLDSA44(), make([]byte, mldsa.PrivateKeySize))))
