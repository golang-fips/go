diff --git a/src/crypto/internal/fips140deps/hostfips/strict_fips.go b/src/crypto/internal/fips140deps/hostfips/strict_fips.go
new file mode 100644
index 0000000000..ac8b3124b3
--- /dev/null
+++ b/src/crypto/internal/fips140deps/hostfips/strict_fips.go
@@ -0,0 +1,18 @@
+// Copyright 2017 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build goexperiment.strictfipsruntime || strictfipsruntime
+
+package hostfips
+
+import "os"
+
+// StrictRuntimeCheck aborts if the host is in FIPS mode (or the test
+// override is set) but the native fips140 module is not enabled.
+func StrictRuntimeCheck(fips140Enabled bool) {
+	if Enabled() && !fips140Enabled {
+		os.Stderr.WriteString("Host FIPS mode is enabled, but the required GODEBUG=fips140 module is disabled\n")
+		os.Exit(1)
+	}
+}
diff --git a/src/internal/goexperiment/exp_strictfipsruntime_off.go b/src/internal/goexperiment/exp_strictfipsruntime_off.go
new file mode 100644
index 0000000000..8cf9e88547
