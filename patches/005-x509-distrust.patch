+func TestSystemVerifyDistrustedSPKI(t *testing.T) {
+	if runtime.GOOS != "darwin" && runtime.GOOS != "windows" && runtime.GOOS != "ios" {
+		t.Skip("no platform verifier")
+	}
+	// Use the same opt-in trusted root as TestPlatformVerifier, rather than a
+	// public leaf fixture which may expire or be revoked by the platform.
+	rootPEM, err := os.ReadFile(rootCertPath)
+	if err != nil {
+		t.Skipf("platform test root unavailable: %v", err)
+	}
+	root, err := certificateFromPEM(string(rootPEM))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := root.Verify(VerifyOptions{}); err != nil {
+		t.Skipf("platform test root is not trusted: %v", err)
+	}
+	keyPEM, err := os.ReadFile(rootKeyPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	block, _ := pem.Decode(keyPEM)
+	if block == nil {
+		t.Fatal("failed to decode platform root key")
+	}
+	key, err := ParseECPrivateKey(block.Bytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leafKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const dnsName = "distrust.testing.golang.invalid"
+	leaf := genCertEdge(t, "leaf", leafKey, func(c *Certificate) {
+		c.DNSNames = []string{dnsName}
+		c.ExtKeyUsage = []ExtKeyUsage{ExtKeyUsageServerAuth}
+	}, leafCertificate, root, key)
+	opts := VerifyOptions{DNSName: dnsName}
+	chains, err := leaf.systemVerify(&opts)
+	if err != nil {
+		t.Fatalf("platform rejected the valid baseline fixture: %v", err)
+	}
+	if len(chains) == 0 || len(chains[0]) == 0 {
+		t.Fatalf("unexpected platform chains: %v", chains)
+	}
+	// The leaf is shared by every platform path, including lower-quality
+	// Windows chains, so no successful result may survive this filter.
+	for _, usages := range [][]ExtKeyUsage{nil, {ExtKeyUsageAny}} {
+		t.Run("leaf", func(t *testing.T) {
+			distrustTestCertificate(t, chains[0][0])
+			opts.KeyUsages = usages
+			got, err := leaf.systemVerify(&opts)
+			var invalid CertificateInvalidError
+			if len(got) != 0 || !errors.As(err, &invalid) || invalid.Reason != NoValidChains {
+				t.Fatalf("systemVerify returned chains %v, err %v; want NoValidChains", got, err)
+			}
+		})
+	}
+}
