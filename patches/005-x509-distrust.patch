+func distrustTestCertificate(t *testing.T, cert *Certificate) {
+	t.Helper()
+	// Do not run these tests in parallel: the denylist is shared with Verify.
+	h := sha256.Sum256(cert.RawSubjectPublicKeyInfo)
+	hash := hex.EncodeToString(h[:])
+	if _, ok := distrustedSPKIHashes[hash]; ok {
+		t.Fatal("test key is already distrusted")
+	}
+	distrustedSPKIHashes[hash] = struct{}{}
+	t.Cleanup(func() { delete(distrustedSPKIHashes, hash) })
+}
+
+func TestVerifyDistrustedSPKI(t *testing.T) {
+	roots, intermediates, leaf := buildTrustGraph(t, trustGraphDescription{
+		Roots: []rootDescription{{Subject: "root"}},
+		Leaf:  "leaf",
+		Graph: []trustGraphEdge{
+			{Issuer: "root", Subject: "inter", Type: intermediateCertificate},
+			{Issuer: "inter", Subject: "leaf", Type: leafCertificate},
+		},
+	})
+	for _, usages := range [][]ExtKeyUsage{nil, {ExtKeyUsageAny}} {
+		opts := VerifyOptions{Roots: roots, Intermediates: intermediates, KeyUsages: usages}
+		chains, err := leaf.Verify(opts)
+		if err != nil || len(chains) != 1 || len(chains[0]) != 3 {
+			t.Fatalf("baseline Verify: chains %v, err %v", chains, err)
+		}
+		for i, cert := range chains[0] {
+			t.Run(cert.Subject.CommonName, func(t *testing.T) {
+				distrustTestCertificate(t, cert)
+				got, err := leaf.Verify(opts)
+				var invalid CertificateInvalidError
+				if len(got) != 0 || !errors.As(err, &invalid) || invalid.Reason != NoValidChains || invalid.Cert != leaf {
+					t.Fatalf("Verify returned chains %v, err %v; want NoValidChains", got, err)
+				}
+				// A distrusted certificate must also fail when explicitly trusted
+				// as a root, without any signature checks or intermediates.
+				directRoots := NewCertPool()
+				directRoots.AddCert(cert)
+				got, err = cert.Verify(VerifyOptions{Roots: directRoots, KeyUsages: []ExtKeyUsage{ExtKeyUsageAny}})
+				if len(got) != 0 || !errors.As(err, &invalid) || invalid.Reason != NoValidChains {
+					t.Fatalf("direct trust at position %d: chains %v, err %v", i, got, err)
+				}
+			})
+		}
+	}
+}
+
+func TestVerifyDistrustedSPKIAlternateChain(t *testing.T) {
+	// Cross-sign the same intermediate key with two roots. Distrusting one
+	// root must leave the other path usable; distrusting the shared key must
+	// reject both intermediate certificates despite their different DER.
+	roots, intermediates, leaf := buildTrustGraph(t, trustGraphDescription{
+		Roots: []rootDescription{{Subject: "root a"}, {Subject: "root b"}},
+		Leaf:  "leaf",
+		Graph: []trustGraphEdge{
+			{Issuer: "root a", Subject: "inter", Type: intermediateCertificate},
+			{Issuer: "root b", Subject: "inter", Type: intermediateCertificate},
+			{Issuer: "inter", Subject: "leaf", Type: leafCertificate},
+		},
+	})
+	opts := VerifyOptions{Roots: roots, Intermediates: intermediates}
+	chains, err := leaf.Verify(opts)
+	if err != nil || len(chains) != 2 {
+		t.Fatalf("baseline Verify: chains %v, err %v", chains, err)
+	}
+	t.Run("retain trusted path", func(t *testing.T) {
+		distrustTestCertificate(t, chains[0][2])
+		got, err := leaf.Verify(opts)
+		if err != nil || len(got) != 1 || !got[0][2].Equal(chains[1][2]) {
+			t.Fatalf("Verify returned chains %v, err %v; want the trusted path", got, err)
+		}
+	})
+	t.Run("cross-signed key", func(t *testing.T) {
+		distrustTestCertificate(t, chains[0][1])
+		got, err := leaf.Verify(opts)
+		var invalid CertificateInvalidError
+		if len(got) != 0 || !errors.As(err, &invalid) || invalid.Reason != NoValidChains {
+			t.Fatalf("Verify returned chains %v, err %v; want NoValidChains", got, err)
+		}
+	})
+	t.Run("unused distrusted certificate", func(t *testing.T) {
+		_, _, unused := buildTrustGraph(t, trustGraphDescription{
+			Roots: []rootDescription{{Subject: "unrelated root"}},
+			Leaf:  "unused",
+			Graph: []trustGraphEdge{{Issuer: "unrelated root", Subject: "unused", Type: intermediateCertificate}},
+		})
+		distrustTestCertificate(t, unused)
+		intermediates.AddCert(unused)
+		got, err := leaf.Verify(opts)
+		if err != nil || !slices.Equal(chainsToStrings(got), chainsToStrings(chains)) {
+			t.Fatalf("unused distrusted certificate changed Verify: chains %v, err %v", got, err)
+		}
+	})
+}
