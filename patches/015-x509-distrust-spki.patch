diff --git a/src/crypto/x509/distrust_test.go b/src/crypto/x509/distrust_test.go
new file mode 100644
--- /dev/null
+++ b/src/crypto/x509/distrust_test.go
@@ -0,0 +1,186 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package x509
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"runtime"
+	"testing"
+	"time"
+)
+
+// These tests must not run in parallel: they temporarily distrust test keys.
+func distrustTestKey(t *testing.T, cert *Certificate) {
+	t.Helper()
+	hash := sha256.Sum256(cert.RawSubjectPublicKeyInfo)
+	key := hex.EncodeToString(hash[:])
+	_, existed := distrustedSPKIHashes[key]
+	distrustedSPKIHashes[key] = struct{}{}
+	t.Cleanup(func() {
+		if !existed {
+			delete(distrustedSPKIHashes, key)
+		}
+	})
+}
+
+func requireDistrustError(t *testing.T, chains [][]*Certificate, err error) {
+	t.Helper()
+	var unknownAuthority UnknownAuthorityError
+	if len(chains) != 0 || !errors.As(err, &unknownAuthority) {
+		t.Fatalf("got %d chains, %v; want no chains and UnknownAuthorityError", len(chains), err)
+	}
+}
+
+func TestVerifyDistrustedSPKIHash(t *testing.T) {
+	leaf, err := certificateFromPEM(googleLeaf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	intermediate, err := certificateFromPEM(gtsIntermediate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	root, err := certificateFromPEM(gtsRoot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots, intermediates := NewCertPool(), NewCertPool()
+	roots.AddCert(root)
+	intermediates.AddCert(intermediate)
+	for _, usage := range []ExtKeyUsage{ExtKeyUsageServerAuth, ExtKeyUsageAny} {
+		opts := VerifyOptions{
+			Roots: roots, Intermediates: intermediates,
+			CurrentTime: time.Unix(1677615892, 0), KeyUsages: []ExtKeyUsage{usage},
+		}
+		if chains, err := leaf.Verify(opts); err != nil || len(chains) != 1 {
+			t.Fatalf("baseline: got %d chains, %v", len(chains), err)
+		}
+		for _, cert := range []*Certificate{leaf, intermediate, root} {
+			t.Run(fmt.Sprintf("%s/usage=%d", cert.Subject.CommonName, usage), func(t *testing.T) {
+				distrustTestKey(t, cert)
+				chains, err := leaf.Verify(opts)
+				requireDistrustError(t, chains, err)
+			})
+		}
+		t.Run(fmt.Sprintf("direct trust/usage=%d", usage), func(t *testing.T) {
+			direct := NewCertPool()
+			direct.AddCert(leaf)
+			directOpts := opts
+			directOpts.Roots = direct
+			if chains, err := leaf.Verify(directOpts); err != nil || len(chains) != 1 {
+				t.Fatalf("direct trust baseline: got %d chains, %v", len(chains), err)
+			}
+			distrustTestKey(t, leaf)
+			chains, err := leaf.Verify(directOpts)
+			requireDistrustError(t, chains, err)
+		})
+	}
+}
+
+func TestVerifyDistrustedSPKIHashAlternatives(t *testing.T) {
+	roots, intermediates, leaf := buildTrustGraph(t, trustGraphDescription{
+		Roots: []rootDescription{{Subject: "root A"}, {Subject: "root B"}},
+		Leaf:  "leaf",
+		Graph: []trustGraphEdge{
+			{Issuer: "root A", Subject: "intermediate", Type: intermediateCertificate},
+			{Issuer: "root B", Subject: "intermediate", Type: intermediateCertificate},
+			{Issuer: "intermediate", Subject: "leaf", Type: leafCertificate},
+		},
+	})
+	for _, usage := range []ExtKeyUsage{ExtKeyUsageServerAuth, ExtKeyUsageAny} {
+		t.Run(fmt.Sprintf("usage=%d", usage), func(t *testing.T) {
+			opts := VerifyOptions{Roots: roots, Intermediates: intermediates, KeyUsages: []ExtKeyUsage{usage}}
+			chains, err := leaf.Verify(opts)
+			if err != nil || len(chains) != 2 {
+				t.Fatalf("baseline: got %d chains, %v; want two", len(chains), err)
+			}
+			t.Run("root", func(t *testing.T) {
+				blockedRoot := chains[0][len(chains[0])-1]
+				distrustTestKey(t, blockedRoot)
+				chains, err := leaf.Verify(opts)
+				if err != nil || len(chains) != 1 {
+					t.Fatalf("got %d chains, %v; want one trusted alternative", len(chains), err)
+				}
+				if chains[0][len(chains[0])-1].Equal(blockedRoot) {
+					t.Fatal("returned the distrusted alternative")
+				}
+			})
+			t.Run("reissued intermediate", func(t *testing.T) {
+				// Both intermediate certificates have the same SPKI but distinct
+				// issuers and DER encodings. Distrusting that key must block both.
+				distrustTestKey(t, chains[0][1])
+				chains, err := leaf.Verify(opts)
+				requireDistrustError(t, chains, err)
+			})
+		})
+	}
+}
+
+func TestContainsDistrustedSPKIHash(t *testing.T) {
+	blocked := &Certificate{Raw: []byte("first certificate"), RawSubjectPublicKeyInfo: []byte("blocked key")}
+	reissued := &Certificate{Raw: []byte("reissued certificate"), RawSubjectPublicKeyInfo: blocked.RawSubjectPublicKeyInfo}
+	allowed := &Certificate{RawSubjectPublicKeyInfo: []byte("allowed key")}
+	distrustTestKey(t, blocked)
+	for _, cert := range []*Certificate{blocked, reissued} {
+		for position := 0; position < 3; position++ {
+			chain := []*Certificate{allowed, allowed, allowed}
+			chain[position] = cert
+			if !containsDistrustedSPKIHash(chain) {
+				t.Fatalf("missed distrusted key at position %d", position)
+			}
+		}
+	}
+	if containsDistrustedSPKIHash(nil) || containsDistrustedSPKIHash([]*Certificate{allowed}) {
+		t.Fatal("distrusted an empty chain or unrelated key")
+	}
+}
+
+func TestSystemVerifyDistrustedSPKIHash(t *testing.T) {
+	if runtime.GOOS != "darwin" && runtime.GOOS != "windows" {
+		t.Skip("requires a platform verifier")
+	}
+	leaf, err := certificateFromPEM(googleLeaf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	intermediate, err := certificateFromPEM(gtsIntermediate)
+	if err != nil {
+		t.Fatal(err)
+	}
+	intermediates := NewCertPool()
+	intermediates.AddCert(intermediate)
+	for _, usage := range []ExtKeyUsage{ExtKeyUsageServerAuth, ExtKeyUsageAny} {
+		opts := VerifyOptions{
+			Intermediates: intermediates, CurrentTime: time.Unix(1677615892, 0),
+			KeyUsages: []ExtKeyUsage{usage},
+		}
+		_, err := leaf.systemVerify(&opts)
+		if err != nil {
+			// The platform may revoke the historical intermediate even at
+			// CurrentTime. Still exercise its filter with a trusted root.
+			t.Logf("system rejected historical chain: %v; trying root directly", err)
+			leaf, err = certificateFromPEM(gtsRoot)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = leaf.systemVerify(&opts)
+			if err != nil {
+				t.Skipf("system does not trust test root: %v", err)
+			}
+		}
+		// Every alternative contains the leaf. Windows may preserve an
+		// existing highest-quality-context error when distrust removes all chains.
+		t.Run(fmt.Sprintf("usage=%d", usage), func(t *testing.T) {
+			distrustTestKey(t, leaf)
+			chains, err := leaf.systemVerify(&opts)
+			if len(chains) != 0 || err == nil {
+				t.Fatalf("got %d chains, %v; want no chains and an error", len(chains), err)
+			}
+		})
+	}
+}
