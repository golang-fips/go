+// license that can be found in the LICENSE file.
+
+//go:build linux && cgo && !android && !gocrypt && !cmd_go_bootstrap && !msan && !no_openssl && !purego
+// +build linux,cgo,!android,!gocrypt,!cmd_go_bootstrap,!msan,!no_openssl,!purego
+
+package backend
+
+import (
+	"io"
+	"runtime"
+	"sync"
+	"testing"
+)
+
+func TestParallelRand(t *testing.T) {
+	if !enabled {
+		t.Skip("must be in fips mode")
+	}
+	parallel := 1000
+	errChan := make(chan error, parallel)
+	var wg sync.WaitGroup
+	for _ = range parallel {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			buf := make([]byte, 16)
+			_, err := io.ReadFull(RandReader, buf)
+			errChan <- err
+			runtime.KeepAlive(buf)
+		}()
+	}
+	wg.Wait()
+	close(errChan)
+	for err := range errChan {
+		if err != nil {
+			t.Fatal("could not read from openssl.RandReader")
+		}
+	}
+}
