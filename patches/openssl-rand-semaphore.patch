-import "unsafe"
+import (
+	"sync"
+	"sync/atomic"
+	"unsafe"
+)
+
+type drbgSem struct {
+	mu sync.Mutex
+	cond *sync.Cond
+	capacity int
+	count int
+}
+
+func (d *drbgSem) Init(numCPU int) {
+	d.capacity = numCPU
+	d.cond = sync.NewCond(&d.mu)
+}
+
+func (d *drbgSem) Acquire() {
+	d.mu.Lock()
+	for d.count >= d.capacity {
+		d.cond.Wait()
+	}
+	d.count++
+	d.mu.Unlock()
+}
+
+func (d *drbgSem) Release() {
+	d.mu.Lock()
+	if d.count > 0 {
+		d.count--
+	} else {
+		panic("openssl.randReader: double semaphore release")
+	}
+	d.mu.Unlock()
+	d.cond.Signal()
+}
+
+var drbgSemInstance drbgSem
+var drbgSemEnabled atomic.Bool
 
 type randReader int
 
 func (randReader) Read(b []byte) (int, error) {
 	// Note: RAND_bytes should never fail; the return value exists only for historical reasons.
 	// We check it even so.
-	if len(b) > 0 && C.go_openssl_RAND_bytes((*C.uchar)(unsafe.Pointer(&b[0])), C.int(len(b))) == 0 {
-		return 0, newOpenSSLError("RAND_bytes")
+	if len(b) > 0 {
+		if drbgSemEnabled.Load() {
+			drbgSemInstance.Acquire()
+			defer drbgSemInstance.Release()
+		}
+	        if C.go_openssl_RAND_bytes((*C.uchar)(unsafe.Pointer(&b[0])), C.int(len(b))) == 0 {
+			return 0, newOpenSSLError("RAND_bytes")
+		}
 	}
 	return len(b), nil
 }
diff --git a/src/vendor/github.com/golang-fips/openssl/v2/sem.go b/src/vendor/github.com/golang-fips/openssl/v2/sem.go
new file mode 100644
index 0000000000..f4c2821a3c
--- /dev/null
+++ b/src/vendor/github.com/golang-fips/openssl/v2/sem.go
@@ -0,0 +1,33 @@
+//go:build cgo && !openssl_no_sem && !cmd_go_bootstrap
+
+package openssl
+
+import (
+	"runtime"
+	"strconv"
+	"syscall"
+)
+
+func init() {
+	// By default, limit concurency to 4x physical CPU count.
+	var threadLimit int
+	var err error
+	if limit, ok := syscall.Getenv("GOLANG_FIPS_DRBG_LIMIT"); ok {
+		threadLimit, err = strconv.Atoi(limit)
+		if err != nil {
+			panic("could not read GOLANG_FIPS_DRBG_LIMIT")
+		}
+	} else {
+		threadLimit = max(runtime.NumCPU(), 1) * 4
+	}
+	switch {
+	case threadLimit < 0:
+		panic("invalid GOLANG_FIPS_DRBG_LIMIT")
+	case threadLimit == 0:
+		// return without enabling semaphore
+		return
+	default:
+		drbgSemInstance.Init(threadLimit)
+		drbgSemEnabled.Store(true)
+	}
+}
